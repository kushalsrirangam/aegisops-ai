# Local demo requires no cloud credentials.
DATABASE_URL=postgresql+psycopg://aegisops:aegisops@db:5432/aegisops
APP_MODE=demo
AWS_REGION=us-east-1
# Optional custom CloudWatch metric in Bedrock mode. Leave namespace empty to disable.
# Publish a Percent-valued ErrorRate with a Service=<incident service> dimension.
AWS_ERROR_RATE_METRIC_NAMESPACE=
AWS_ERROR_RATE_METRIC_NAME=ErrorRate
AWS_ERROR_RATE_METRIC_DIMENSION_NAME=Service
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
CORS_ORIGINS=http://localhost:5173
